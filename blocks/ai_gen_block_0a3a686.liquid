{% doc %}
  @prompt
    Create a modern “Social Proof Slider” section for my Shopify store with infinite horizontal scrolling animation.
    
    Title (IMPORTANT):
    - Set the default heading as:
      “🫶 Loved by favourites & 20,000+ more just like you”
    - Allow editing of this title from settings
    
    Layout:
    - Full-width section
    - Title centered at the top
    - Below the title, display a horizontal scrolling slider of image cards
    
    Slider Functionality:
    - Infinite horizontal scrolling (loop animation)
    - Auto-scroll continuously (marquee style)
    - Smooth linear animation (no jerks)
    - Pause animation on hover (desktop)
    - Touch swipe enabled on mobile
    - Seamless looping (duplicate items internally to avoid gaps)
    
    Image Cards:
    - All image cards must have consistent height (IMPORTANT)
    - Maintain uniform aspect ratio (portrait preferred, e.g. 4:5)
    - Rounded corners (medium radius)
    - Equal spacing between cards
    - Images should cover fully (object-fit: cover)
    
    Customization Options:
    - Upload multiple images (UGC / Instagram-style content)
    - Control:
      - Animation speed (slow / medium / fast + custom range)
      - Card height
      - Gap between cards
      - Border radius
    - Toggle:
      - Pause on hover
      - Enable/disable autoplay
    - Option to duplicate rows (single row / double row slider)
    
    Design:
    - Clean, minimal, premium
    - Focus on real user content (UGC style)
    - Optional subtle hover effect (scale slightly)
    
    Mobile Optimization:
    - Fully responsive
    - Smooth touch scrolling
    - Maintain consistent card size
    - No layout shift
    
    Performance:
    - Lazy load images
    - Optimize for smooth animation (use CSS transform, not heavy JS)
    
    Optional Enhancements:
    - Slight fade gradient on left/right edges for premium look
    - Subtle entrance animation on section load
    
    Goal:
    Create a high-converting, visually engaging infinite scrolling slider that builds trust using real user content and feels smooth and premium like top D2C brands., provide option to add upto 30 photos , just add one feature also that even though there can be upto 30 images but it's not necssary that there will be thirty ,for each image given an toggle button to enable disable that , just add one feature also that even though there can be upto 30 images but it's not necssary that there will be thirty ,for each image given an toggle button to enable disable that 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}


{% liquid
  case block.settings.card_aspect_ratio
    when '3:4'
      assign card_ratio = 0.75
    when '1:1'
      assign card_ratio = 1.0
    when '9:16'
      assign card_ratio = 0.5625
    else
      assign card_ratio = 0.8
  endcase

  assign card_height = block.settings.card_height
  assign card_height_mobile = block.settings.card_height_mobile
  assign card_width = card_height | times: card_ratio | round
  assign card_width_mobile = card_height_mobile | times: card_ratio | round

  case block.settings.animation_speed
    when 'slow'
      assign scroll_speed = 60
    when 'medium'
      assign scroll_speed = 120
    when 'fast'
      assign scroll_speed = 200
    when 'very_fast'
      assign scroll_speed = 300
    else
      assign scroll_speed = block.settings.scroll_speed
  endcase
%}

{% style %}
  .ai-social-proof-slider-{{ ai_gen_id }} {
    --sps-card-h: {{ card_height }}px;
    --sps-card-ratio: {{ card_ratio }};
    --sps-gap: {{ block.settings.card_gap }}px;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    position: relative;
    display: block;
  }

  .ai-social-proof-slider__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 auto {{ block.settings.heading_margin_bottom }}px;
    padding: 0 20px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    max-width: 800px;
    overflow-wrap: break-word;
  }

  .ai-social-proof-slider__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    {% if block.settings.enable_hover_effect %}
      padding: 10px 0;
    {% endif %}
  }

  .ai-social-proof-slider__track-wrapper-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
  }

  {% if block.settings.show_fade_edges %}
    .ai-social-proof-slider__track-wrapper-{{ ai_gen_id }}::before,
    .ai-social-proof-slider__track-wrapper-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: min({{ block.settings.fade_width }}px, 12vw);
      z-index: 2;
      pointer-events: none;
    }

    .ai-social-proof-slider__track-wrapper-{{ ai_gen_id }}::before {
      left: 0;
      background: linear-gradient(to right, {{ block.settings.background_color }}, {{ block.settings.background_color | color_modify: 'alpha', 0 }});
    }

    .ai-social-proof-slider__track-wrapper-{{ ai_gen_id }}::after {
      right: 0;
      background: linear-gradient(to left, {{ block.settings.background_color }}, {{ block.settings.background_color | color_modify: 'alpha', 0 }});
    }
  {% endif %}

  .ai-social-proof-slider__track-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    gap: var(--sps-gap);
    width: max-content;
    will-change: transform;
  }

  .ai-social-proof-slider__card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    height: var(--sps-card-h);
    width: calc(var(--sps-card-h) * var(--sps-card-ratio));
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    position: relative;
    background-color: #f4f4f4;
    {% if block.settings.enable_hover_effect %}
      transition: transform 0.3s ease;
    {% endif %}
  }

  {% if block.settings.enable_hover_effect %}
    @media (hover: hover) and (pointer: fine) {
      .ai-social-proof-slider__card-{{ ai_gen_id }}:hover {
        transform: scale(1.03);
      }
    }
  {% endif %}

  .ai-social-proof-slider__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .ai-social-proof-slider__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-social-proof-slider__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  {% if block.settings.show_entrance_animation %}
    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
      .ai-social-proof-slider-{{ ai_gen_id }} {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.8s ease, transform 0.8s ease;
      }

      .ai-social-proof-slider-{{ ai_gen_id }}.is-visible {
        opacity: 1;
        transform: none;
      }
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .ai-social-proof-slider__track-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-social-proof-slider-{{ ai_gen_id }} {
      --sps-card-h: {{ card_height_mobile }}px;
      --sps-gap: {{ block.settings.card_gap | times: 0.75 | round }}px;
      padding: {{ block.settings.section_padding_top | times: 0.7 | round }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 | round }}px;
    }

    .ai-social-proof-slider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 | round }}px;
      margin-bottom: {{ block.settings.heading_margin_bottom | times: 0.6 | round }}px;
      padding: 0 16px;
    }
  }
{% endstyle %}

<social-proof-slider-{{ ai_gen_id }}
  class="ai-social-proof-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-pause-on-hover="{{ block.settings.pause_on_hover }}"
  data-speed="{{ scroll_speed }}"
  data-mobile-speed="{{ block.settings.mobile_speed_percent }}"
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-social-proof-slider__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  <div class="ai-social-proof-slider__track-wrapper-{{ ai_gen_id }}" data-viewport>
    <div class="ai-social-proof-slider__track-{{ ai_gen_id }}" data-track>
      {% liquid
        assign total_images = 0
        for i in (1..30)
          assign enable_key = 'enable_image_' | append: i
          assign image_key = 'image_' | append: i
          if block.settings[enable_key] and block.settings[image_key] != blank
            assign total_images = total_images | plus: 1
          endif
        endfor
      %}

      {% if total_images > 0 %}
        {% for i in (1..30) %}
          {% liquid
            assign enable_key = 'enable_image_' | append: i
            assign image_key = 'image_' | append: i
            assign current_image = block.settings[image_key]
          %}
          {% if block.settings[enable_key] and current_image != blank %}
            <div class="ai-social-proof-slider__card-{{ ai_gen_id }}">
              <img
                src="{{ current_image | image_url: width: 540 }}"
                srcset="
                  {{ current_image | image_url: width: 360 }} 360w,
                  {{ current_image | image_url: width: 540 }} 540w,
                  {{ current_image | image_url: width: 720 }} 720w,
                  {{ current_image | image_url: width: 1080 }} 1080w
                "
                sizes="(max-width: 749px) {{ card_width_mobile }}px, {{ card_width }}px"
                alt="{{ current_image.alt | escape }}"
                class="ai-social-proof-slider__image-{{ ai_gen_id }}"
                loading="lazy"
                decoding="async"
                draggable="false"
                width="{{ card_width }}"
                height="{{ card_height }}"
              >
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          <div class="ai-social-proof-slider__card-{{ ai_gen_id }}">
            <div class="ai-social-proof-slider__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</social-proof-slider-{{ ai_gen_id }}>

<script>
  (function () {
    var tagName = 'social-proof-slider-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class SocialProofSlider extends HTMLElement {
      connectedCallback() {
        this.viewport = this.querySelector('[data-viewport]');
        this.track = this.querySelector('[data-track]');
        if (!this.viewport || !this.track) return;

        this.originals = Array.from(this.track.children);
        if (!this.originals.length) return;

        this.baseSpeed = parseFloat(this.dataset.speed) || 200;
        this.mobileFactor = (parseFloat(this.dataset.mobileSpeed) || 100) / 100;
        this.pauseOnHover = this.dataset.pauseOnHover === 'true';
        this.mobileQuery = window.matchMedia('(max-width: 749px)');
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.autoplay = this.dataset.autoplay === 'true';

        this.offset = 0;
        this.loopWidth = 0;
        this.currentSpeed = 0;
        this.velocity = 0;
        this.hovering = false;
        this.dragging = false;
        this.inView = false;
        this.imagesReleased = false;
        this.lastTime = null;
        this.tick = this.tick.bind(this);

        this.build();
        this.bindPointer();

        this.resizeObserver = new ResizeObserver(() => this.build());
        this.resizeObserver.observe(this.viewport);

        this.intersectionObserver = new IntersectionObserver(
          (entries) => {
            this.inView = entries[0].isIntersecting;
            if (this.inView) {
              this.classList.add('is-visible');
              this.releaseImages();
              this.start();
            } else {
              this.stop();
            }
          },
          { rootMargin: '300px 0px' }
        );
        this.intersectionObserver.observe(this);
      }

      disconnectedCallback() {
        this.stop();
        if (this.resizeObserver) this.resizeObserver.disconnect();
        if (this.intersectionObserver) this.intersectionObserver.disconnect();
      }

      // Clone the image set until the track is always wider than the screen,
      // so the loop never shows a gap — no matter how few images are enabled.
      build() {
        this.track.querySelectorAll('[data-clone]').forEach((node) => node.remove());
        this.appendCloneSet();

        var firstClone = this.track.querySelector('[data-clone]');
        this.loopWidth = firstClone.offsetLeft - this.originals[0].offsetLeft;
        if (this.loopWidth <= 0) return;

        var setsNeeded = Math.ceil(this.viewport.offsetWidth / this.loopWidth) + 1;
        for (var sets = 2; sets < setsNeeded; sets++) this.appendCloneSet();

        if (this.imagesReleased) this.releaseImages();
        this.render();
      }

      appendCloneSet() {
        this.originals.forEach((node) => {
          var clone = node.cloneNode(true);
          clone.setAttribute('data-clone', '');
          clone.setAttribute('aria-hidden', 'true');
          this.track.appendChild(clone);
        });
      }

      // Images start lazy for page speed; once the slider is near the screen,
      // load them all so off-screen cards are ready before they scroll in.
      releaseImages() {
        this.imagesReleased = true;
        this.track.querySelectorAll('img[loading="lazy"]').forEach((img) => {
          img.loading = 'eager';
        });
      }

      bindPointer() {
        var startX = 0;
        var startOffset = 0;
        var lastX = 0;
        var lastMoveTime = 0;

        this.viewport.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') this.hovering = true;
        });
        this.viewport.addEventListener('pointerleave', (event) => {
          if (event.pointerType === 'mouse') this.hovering = false;
        });

        this.viewport.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          this.dragging = true;
          this.velocity = 0;
          startX = lastX = event.clientX;
          startOffset = this.offset;
          lastMoveTime = performance.now();
          this.viewport.classList.add('is-dragging');
          this.viewport.setPointerCapture(event.pointerId);
        });

        this.viewport.addEventListener('pointermove', (event) => {
          if (!this.dragging) return;
          var now = performance.now();
          var dt = Math.max(now - lastMoveTime, 1);
          this.velocity = ((lastX - event.clientX) / dt) * 1000;
          lastX = event.clientX;
          lastMoveTime = now;
          this.offset = startOffset - (event.clientX - startX);
          this.render();
        });

        var endDrag = () => {
          if (!this.dragging) return;
          this.dragging = false;
          this.viewport.classList.remove('is-dragging');
          if (performance.now() - lastMoveTime > 100) this.velocity = 0;
        };
        this.viewport.addEventListener('pointerup', endDrag);
        this.viewport.addEventListener('pointercancel', endDrag);
      }

      targetSpeed() {
        if (!this.autoplay || this.reducedMotion.matches) return 0;
        if (this.dragging || (this.pauseOnHover && this.hovering)) return 0;
        return this.baseSpeed * (this.mobileQuery.matches ? this.mobileFactor : 1);
      }

      start() {
        if (this.frame) return;
        this.lastTime = null;
        this.frame = requestAnimationFrame(this.tick);
      }

      stop() {
        if (this.frame) cancelAnimationFrame(this.frame);
        this.frame = null;
      }

      tick(time) {
        var dt = this.lastTime === null ? 0 : Math.min((time - this.lastTime) / 1000, 0.1);
        this.lastTime = time;

        // Ease toward the target speed so pausing/resuming feels smooth.
        this.currentSpeed += (this.targetSpeed() - this.currentSpeed) * Math.min(1, dt * 6);

        if (!this.dragging) {
          this.offset += (this.currentSpeed + this.velocity) * dt;
          this.velocity *= Math.pow(0.04, dt);
          if (Math.abs(this.velocity) < 5) this.velocity = 0;
          this.render();
        }

        this.frame = requestAnimationFrame(this.tick);
      }

      render() {
        if (this.loopWidth <= 0) return;
        var position = ((this.offset % this.loopWidth) + this.loopWidth) % this.loopWidth;
        this.track.style.transform = 'translate3d(' + -position + 'px, 0, 0)';
      }
    }

    customElements.define(tagName, SocialProofSlider);
  })();
</script>

