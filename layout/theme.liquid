<!doctype html>
{%- comment -%}
  SoulStruck: `ss-kit-unselected` gates the product page until the shopper picks a kit.
  `product.selected_variant` is only set when the URL carries ?variant=..., so this is
  true exactly when Shopify would silently auto-select the first variant for us.
{%- endcomment -%}
{%- liquid
  assign ss_kit_unselected = false
  if request.page_type == 'product' and product.has_only_default_variant == false and product.variants.size > 1 and product.selected_variant == blank
    assign ss_kit_unselected = true
  endif
-%}
<html
  class="{% if request.design_mode %}shopify-design-mode{% endif %}{% if ss_kit_unselected %} ss-kit-unselected{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
