<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  {%- comment -%}
    SoulStruck: a slim bar pinned to the bottom of the screen for the whole page,
    holding just the buy actions. Each button clicks its twin in the buy block,
    so the kit gate, Shiprocket checkout and the add-to-cart popup behave exactly
    as they do there.
  {%- endcomment -%}
  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-{{ settings.popover_color_scheme }}"
      data-stuck="true"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      <div class="sticky-add-to-cart__actions">
        {%- if section.settings.sticky_show_wishlist -%}
          {% render 'wishlist-button', product: product, context: 'sticky' %}
        {%- endif -%}

        <button
          type="button"
          class="sticky-add-to-cart__button add-to-cart-button button"
          ref="addToCartButton"
          on:click="/handleAddToCartClick"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          <span
            class="add-to-cart-text"
          >
            {% if current_variant.available %}
              <span class="svg-wrapper add-to-cart-icon">
                {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
              </span>
            {% endif %}
            <span class="add-to-cart-text__content">
              <span>
                {%- if current_variant.available -%}
                  {{- 'products.product.add_to_cart' | t -}}
                {%- elsif current_variant == blank -%}
                  {{- 'products.product.unavailable' | t -}}
                {%- else -%}
                  {{- 'products.product.sold_out' | t -}}
                {%- endif -%}
              </span>
              <span
                ref="quantityDisplay"
                {% if current_variant.available and initial_quantity > 1 %}
                  style="display: inline;"
                {% else %}
                  style="display: none;"
                {% endif %}
              >
                {{- ' (' -}}
                <span ref="quantityNumber">{{- initial_quantity -}}</span>
                {{- ')' -}}
              </span>
            </span>
          </span>
          <span class="add-to-cart__added">
            <span class="svg-wrapper add-to-cart__added-icon">
              {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
            </span>
          </span>
        </button>

        {%- if section.settings.sticky_show_buy_now -%}
          {%- comment -%}
            Shown from the start so the bar doesn't shift when the checkout app's
            button arrives a moment later; sticky-add-to-cart.js hides it only if
            the buy block never gets a buy-now button to click.
          {%- endcomment -%}
          <button
            type="button"
            class="sticky-add-to-cart__button sticky-add-to-cart__button--buy-now button"
            ref="buyNowButton"
            on:click="/handleBuyNowClick"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span class="sticky-add-to-cart__buy-now-label">
              {{- section.settings.sticky_buy_now_label | default: 'Buy now' | escape -}}
            </span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </sticky-add-to-cart>
{% endif %}

{% render 'product-information-content',
  product_media_size: closest.product.media.size,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% stylesheet %}
  /*
    SoulStruck: always-on buy bar with just Add to cart and Buy now.
    Phones: a full-width bar on the bottom edge. Larger screens: a floating pill.
    sticky-add-to-cart.js keeps --sticky-add-to-cart-space in step with the bar
    so the end of the page can scroll clear of it.
  */
  body {
    padding-bottom: var(--sticky-add-to-cart-space, 0px);
  }

  .sticky-add-to-cart__bar {
    --sticky-atc-height: 50px;
    position: fixed;
    left: 50%;
    bottom: 20px;
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    width: min(560px, calc(100vw - 48px));
    padding: 8px;
    border: 1px solid rgb(20 24 38 / 0.08);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.92);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
    box-shadow: 0 14px 36px rgb(20 24 38 / 0.16), 0 2px 6px rgb(20 24 38 / 0.06);
    transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition: transform 0.35s var(--ease-out-quad), opacity 0.35s var(--ease-out-quad);

      @starting-style {
        opacity: 0;
        transform: translateX(-50%) translateY(16px);
      }
    }
  }

  .sticky-add-to-cart__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sticky-add-to-cart .sticky-add-to-cart__button.button {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: var(--sticky-atc-height);
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .sticky-add-to-cart .sticky-add-to-cart__button.button:active:not(:disabled) {
    transform: scale(0.98);
  }

  .sticky-add-to-cart .sticky-add-to-cart__button.button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Add to cart: outlined */
  .sticky-add-to-cart .sticky-add-to-cart__button.add-to-cart-button {
    background: #fff;
    color: #141826;
    border: 1.5px solid #141826;
    box-shadow: none;
  }

  @media (hover: hover) {
    .sticky-add-to-cart .sticky-add-to-cart__button.add-to-cart-button:hover:not(:disabled) {
      background: #fdf4f2;
      color: #141826;
    }

    .sticky-add-to-cart .sticky-add-to-cart__button--buy-now.button:hover:not(:disabled) {
      background: #24242a;
      border-color: #24242a;
      color: #fff;
    }
  }

  .sticky-add-to-cart .add-to-cart-text__content {
    font-weight: 700;
  }

  /* Buy now: solid, the first choice */
  .sticky-add-to-cart .sticky-add-to-cart__button--buy-now.button {
    background: #0b0b0d;
    color: #fff;
    border: 1.5px solid #0b0b0d;
    box-shadow: 0 6px 16px rgb(11 11 13 / 0.2);
  }

  .sticky-add-to-cart__button--buy-now[aria-busy='true'] {
    cursor: progress;
    opacity: 0.8;
  }

  /* Payment icons copied from the checkout app's own buy-now button */
  .sticky-add-to-cart__pay {
    display: block;
    height: 18px;
    width: auto;
    flex: 0 0 auto;
  }

  /* Only when the wishlist setting is switched back on */
  .wishlist-btn--sticky {
    flex: 0 0 auto;
    width: var(--sticky-atc-height);
    height: var(--sticky-atc-height);
    border: 1.5px solid rgb(20 24 38 / 0.15);
    border-radius: 14px;
    background: #fff;
  }

  .wishlist-btn--sticky .wishlist-btn__icon {
    width: 20px;
    height: 20px;
  }

  /* The kit gate scrolls the picker into view: keep it clear of the header and this bar. */
  .product-details variant-picker {
    scroll-margin-top: 88px;
    scroll-margin-bottom: calc(var(--sticky-add-to-cart-space, 0px) + 16px);
  }

  @media screen and (min-width: 750px) {
    .product-details variant-picker {
      scroll-margin-top: 128px;
    }
  }

  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      --sticky-atc-height: 48px;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
      border-width: 1px 0 0;
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -8px 24px rgb(20 24 38 / 0.08);
      transform: none;
    }

    .sticky-add-to-cart .sticky-add-to-cart__button.button {
      padding: 0 12px;
      border-radius: 13px;
      font-size: 14.5px;
    }
  }

  @media screen and (max-width: 749px) and (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      @starting-style {
        opacity: 0;
        transform: translateY(100%);
      }
    }
  }

  @media screen and (max-width: 349px) {
    .sticky-add-to-cart .sticky-add-to-cart__button.button {
      padding: 0 8px;
      font-size: 14px;
    }

    .sticky-add-to-cart__pay {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_show_wishlist",
      "label": "Show wishlist in sticky bar",
      "default": true,
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart }}"
    },
    {
      "type": "checkbox",
      "id": "sticky_show_buy_now",
      "label": "Show buy now in sticky bar",
      "info": "Only appears when the product page has a buy now button of its own.",
      "default": true,
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart }}"
    },
    {
      "type": "text",
      "id": "sticky_buy_now_label",
      "label": "Buy now label",
      "default": "Buy now",
      "visible_if": "{{ section.settings.sticky_show_buy_now }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
