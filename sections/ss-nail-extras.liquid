{%- comment -%}
  Nail extras — small add-ons (adhesive tabs, glue, cuticle oil, buffer…) as a
  card grid, placed under "You might also like" on the product page.
  4 across from tablet up, 2 × 2 on phones.

  "Add to cart" buttons carry data-variant-id and the "Add to cart" label, so the
  Shiprocket cart handles them like every other product card (and the add-to-cart
  popup opens). The script below only adds the item itself when Shiprocket hasn't
  loaded yet.
{%- endcomment -%}
{%- liquid
  assign products = section.settings.products
  assign button_label = section.settings.button_label | default: 'Add to cart'
-%}

{%- if products.size > 0 -%}
  <div
    class="ss-nx section section--page-width color-{{ section.settings.color_scheme }}"
    style="--ss-nx-pt: {{ section.settings.padding_top }}px; --ss-nx-pb: {{ section.settings.padding_bottom }}px; --ss-nx-cols: {{ section.settings.columns_desktop }};"
  >
    <div class="ss-nx__inner">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="ss-nx__head">
          {%- if section.settings.heading != blank -%}
            <h2 class="ss-nx__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="ss-nx__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="ss-nx__grid" role="list">
        {%- for product in products -%}
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign on_sale = false
            if variant.compare_at_price > variant.price
              assign on_sale = true
              assign percent_off = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
            endif
          -%}
          <li class="ss-nx__card">
            <a class="ss-nx__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'ss-nx__img',
                    widths: '200, 300, 400, 600',
                    sizes: '(min-width: 990px) 300px, (min-width: 750px) 25vw, 50vw',
                    alt: product.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'ss-nx__img ss-nx__img--placeholder' }}
              {%- endif -%}
            </a>

            <div class="ss-nx__body">
              <a class="ss-nx__name" href="{{ product.url }}">{{ product.title | escape }}</a>

              <p class="ss-nx__price">
                <span class="ss-nx__now">{{ variant.price | money }}</span>
                {%- if on_sale -%}
                  <s class="ss-nx__was">{{ variant.compare_at_price | money }}</s>
                  <span class="ss-nx__off">{{ percent_off }}% off</span>
                {%- endif -%}
              </p>

              {%- if variant.available -%}
                <button type="button" class="ss-nx__add" data-variant-id="{{ variant.id }}" data-add-cart>
                  <svg class="ss-nx__add-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  {{- button_label | escape -}}
                </button>
              {%- else -%}
                <button type="button" class="ss-nx__add" disabled>{{ 'products.product.sold_out' | t }}</button>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <script>
    (function () {
      if (window.ssNailExtrasBound) return;
      window.ssNailExtrasBound = true;

      // Shiprocket's capture listener normally handles these buttons and stops the
      // click before it gets here; this only runs when it hasn't loaded yet.
      document.addEventListener('click', function (event) {
        var button = event.target.closest && event.target.closest('.ss-nx__add[data-variant-id]');
        if (!button || button.disabled || button.dataset.busy) return;
        event.preventDefault();
        button.dataset.busy = 'true';
        var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        fetch(root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: Number(button.dataset.variantId), quantity: 1 }),
        })
          .then(function (response) {
            if (response.ok) document.dispatchEvent(new CustomEvent('cart:refresh'));
          })
          .catch(function () {})
          .finally(function () {
            delete button.dataset.busy;
          });
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .ss-nx {
    padding-block: var(--ss-nx-pt, 40px) var(--ss-nx-pb, 48px);
  }

  .ss-nx__head {
    margin-bottom: 28px;
    text-align: center;
  }

  .ss-nx__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 700);
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #a85b6c;
  }

  .ss-nx__sub {
    margin: 8px 0 0;
    font-size: 15px;
    color: rgb(20 24 38 / 0.6);
  }

  .ss-nx__grid {
    display: grid;
    grid-template-columns: repeat(var(--ss-nx-cols, 4), minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ss-nx__card {
    display: flex;
    flex-direction: column;
    padding: 10px;
    border: 1px solid #f1e3e0;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 6px 18px rgb(226 87 76 / 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .ss-nx__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 14px;
    background: #fbf3f1;
  }

  .ss-nx__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  @media (hover: hover) {
    .ss-nx__card:hover {
      transform: translateY(-3px);
      border-color: #ead3cf;
      box-shadow: 0 14px 30px rgb(20 24 38 / 0.1);
    }

    .ss-nx__card:hover .ss-nx__img {
      transform: scale(1.04);
    }
  }

  .ss-nx__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 12px 4px 4px;
  }

  .ss-nx__name {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: #141826;
    text-decoration: none;
  }

  .ss-nx__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    margin: 0 0 8px;
  }

  .ss-nx__now {
    font-size: 16px;
    font-weight: 700;
    color: #141826;
  }

  .ss-nx__was {
    font-size: 13px;
    color: #9aa0ab;
  }

  .ss-nx__off {
    align-self: center;
    padding: 2px 6px;
    border-radius: 5px;
    background: #e5f5e8;
    color: #2f9b3c;
    font-size: 11px;
    font-weight: 700;
  }

  .ss-nx__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    height: 44px;
    margin-top: auto;
    border: 0;
    border-radius: 12px;
    background: #0b0b0d;
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease, opacity 0.2s ease;
  }

  .ss-nx__add-icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  @media (hover: hover) {
    .ss-nx__add:hover:not(:disabled) {
      background: #24242a;
    }
  }

  .ss-nx__add:active:not(:disabled) {
    transform: scale(0.98);
  }

  .ss-nx__add:disabled {
    background: #e4e4e8;
    color: #6b7080;
    cursor: not-allowed;
  }

  /* While the add is in flight (Shiprocket marks the button; the fallback sets data-busy) */
  .ss-nx__add[data-srsc-in-flight='true'],
  .ss-nx__add[data-busy] {
    opacity: 0.7;
    cursor: progress;
  }

  .ss-nx__add[data-srsc-in-flight='true']:disabled {
    background: #0b0b0d;
    color: #fff;
  }

  @media screen and (max-width: 749px) {
    .ss-nx__head {
      margin-bottom: 20px;
    }

    .ss-nx__title {
      font-size: 24px;
    }

    .ss-nx__sub {
      font-size: 14px;
    }

    .ss-nx__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .ss-nx__card {
      padding: 8px;
      border-radius: 16px;
    }

    .ss-nx__media {
      border-radius: 12px;
    }

    .ss-nx__body {
      gap: 4px;
      padding: 10px 2px 2px;
    }

    .ss-nx__name {
      font-size: 14px;
    }

    .ss-nx__now {
      font-size: 15px;
    }

    .ss-nx__add {
      height: 40px;
      border-radius: 10px;
      font-size: 13.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-nx__card,
    .ss-nx__img,
    .ss-nx__add {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nail extras",
  "tag": "section",
  "class": "ss-nail-extras-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Must-Have Nail Extras"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Perfectly paired products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "info": "Phones always show 2 per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Nail extras"
    }
  ]
}
{% endschema %}
