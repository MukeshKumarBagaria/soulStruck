{% comment %}
  Trust Marquee
  - Infinite scrolling strip of trust items (icon + label)
  - Meant for the header group, directly below the header
  - Sits in normal page flow, so it scrolls out of view while the header stays pinned
{% endcomment %}

{%- liquid
  assign bid = section.id | replace: '_', '' | downcase
  assign repeats = section.settings.repeats
-%}

{% style %}
  .stm-{{ bid }} {
    --stm-bg: {{ section.settings.bg_color }};
    --stm-text: {{ section.settings.text_color }};
    --stm-icon: {{ section.settings.icon_color }};
    --stm-sep: {{ section.settings.separator_color }};
    --stm-gap: {{ section.settings.item_gap }}px;
    --stm-icon-size: {{ section.settings.icon_size }}px;
    --stm-font-size: {{ section.settings.font_size }}px;
    --stm-speed: {{ section.settings.speed }}s;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--stm-bg);
    color: var(--stm-text);
    padding: {{ section.settings.padding_y }}px 0;
    {%- if section.settings.border_bottom %}
      border-bottom: 1px solid {{ section.settings.border_color }};
    {%- endif %}
    {%- if section.settings.border_top %}
      border-top: 1px solid {{ section.settings.border_color }};
    {%- endif %}
  }

  .stm-{{ bid }} *,
  .stm-{{ bid }} *::before,
  .stm-{{ bid }} *::after { box-sizing: border-box; }

  /* Track holds two identical halves; shifting by -50% loops seamlessly */
  .stm-{{ bid }}__track {
    display: flex;
    width: max-content;
    animation: stm-scroll-{{ bid }} var(--stm-speed) linear infinite;
    will-change: transform;
  }

  {%- if section.settings.direction == 'right' %}
    .stm-{{ bid }}__track { animation-direction: reverse; }
  {%- endif %}

  {%- if section.settings.pause_on_hover %}
    @media (hover: hover) {
      .stm-{{ bid }}:hover .stm-{{ bid }}__track { animation-play-state: paused; }
    }
  {%- endif %}

  .stm-{{ bid }}:focus-within .stm-{{ bid }}__track { animation-play-state: paused; }

  @keyframes stm-scroll-{{ bid }} {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stm-{{ bid }}__track { animation: none; }
  }

  .stm-{{ bid }}__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stm-{{ bid }}__item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0 calc(var(--stm-gap) / 2);
    position: relative;
  }

  {%- if section.settings.show_separator %}
    .stm-{{ bid }}__item::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      width: 4px;
      height: 4px;
      margin-top: -2px;
      margin-right: -2px;
      border-radius: 50%;
      background: var(--stm-sep);
    }
  {%- endif %}

  .stm-{{ bid }}__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .stm-{{ bid }}__icon {
    flex-shrink: 0;
    width: var(--stm-icon-size);
    height: var(--stm-icon-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--stm-icon);
  }

  .stm-{{ bid }}__icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: {{ section.settings.icon_stroke }};
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .stm-{{ bid }}__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .stm-{{ bid }}__label {
    font-size: var(--stm-font-size);
    font-weight: {{ section.settings.font_weight }};
    text-transform: {{ section.settings.text_transform }};
    letter-spacing: -0.005em;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .stm-{{ bid }} {
      --stm-font-size: {{ section.settings.font_size | minus: 1 }}px;
      --stm-gap: {{ section.settings.item_gap | times: 0.75 | round }}px;
    }
  }
{% endstyle %}

{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.label != blank -%}
      {%- liquid
        assign tag = 'span'
        if block.settings.link != blank
          assign tag = 'a'
        endif
      -%}
      <li class="stm-{{ bid }}__item">
        <{{ tag }} class="stm-{{ bid }}__link"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %}>
          {%- if block.settings.image != blank or block.settings.icon != 'none' -%}
            <span class="stm-{{ bid }}__icon" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 64 }}" alt="" width="20" height="20" loading="lazy">
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {%- when 'pin' -%}
                    <svg viewBox="0 0 24 24"><path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {%- when 'lightning' -%}
                    <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  {%- when 'chat' -%}
                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- when 'check-circle' -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'card' -%}
                    <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                  {%- when 'lock' -%}
                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                  {%- when 'sparkle' -%}
                    <svg viewBox="0 0 24 24"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- when 'globe' -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  {%- when 'package' -%}
                    <svg viewBox="0 0 24 24"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
          {%- endif -%}
          <span class="stm-{{ bid }}__label">{{ block.settings.label | escape }}</span>
        </{{ tag }}>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if section.blocks.size > 0 -%}
  <div class="stm-{{ bid }}" role="region" aria-label="{{ section.settings.aria_label | escape }}" {{ section.shopify_attributes }}>
    <div class="stm-{{ bid }}__track">
      {%- for half in (1..2) -%}
        {%- comment -%} Each half repeats the item set so the strip is wider than any viewport {%- endcomment -%}
        <ul class="stm-{{ bid }}__group"{% if half == 2 %} aria-hidden="true"{% endif %}>
          {%- for r in (1..repeats) -%}
            {%- if half == 1 and r == 1 -%}
              {{ items }}
            {%- else -%}
              {{ items | replace: '<a ', '<a tabindex="-1" ' }}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust marquee",
  "tag": "div",
  "class": "ss-trust-marquee-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Loop duration (higher = slower)",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "repeats",
      "label": "Item set repeats",
      "info": "Increase if you see a gap on very wide screens",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label",
      "default": "Why shop with us"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between items",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show dot separator",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Bottom border",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography & icons"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Label size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Label weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Label case",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "lowercase"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "icon_stroke",
      "label": "Icon stroke width",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 2
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f7f8fb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0f0f0f"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#0f0f0f"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator dot",
      "default": "#bdbdbd"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#ececec"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" },
            { "value": "pin", "label": "Location pin" },
            { "value": "lightning", "label": "Lightning" },
            { "value": "chat", "label": "Chat" },
            { "value": "check", "label": "Check" },
            { "value": "check-circle", "label": "Check circle" },
            { "value": "shield", "label": "Shield" },
            { "value": "card", "label": "Card" },
            { "value": "lock", "label": "Lock" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" },
            { "value": "globe", "label": "Globe" },
            { "value": "package", "label": "Package" },
            { "value": "support", "label": "Support" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "Overrides the icon above"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "trust item"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust marquee",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "label": "ships in 24-48 hours" } },
        { "type": "item", "settings": { "icon": "heart", "label": "20,000+ girlies" } },
        { "type": "item", "settings": { "icon": "pin", "label": "delivery across india" } },
        { "type": "item", "settings": { "icon": "lightning", "label": "fast checkout" } },
        { "type": "item", "settings": { "icon": "chat", "label": "24 / 7 support" } },
        { "type": "item", "settings": { "icon": "check", "label": "safe payments" } }
      ]
    }
  ]
}
{% endschema %}
