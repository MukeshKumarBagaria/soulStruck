{%- doc -%}
  SoulStruck — the pink tick bullet used by the kit contents card.

  Inline rather than an icon asset so it inherits `currentcolor` from the accent setting
  on `blocks/ss-kit-includes.liquid`.
{%- enddoc -%}
<svg
  class="ss-kit-includes__tick"
  viewBox="0 0 20 20"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="10" cy="10" r="10" fill="currentcolor"></circle>
  <path
    d="M5.9 10.2 8.6 12.9 14.1 7.4"
    fill="none"
    stroke="#fff"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
