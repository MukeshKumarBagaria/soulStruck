{% doc %}
  @prompt
    Create a premium Shopify product page countdown timer block inspired by modern beauty and cosmetics brands. The section should look elegant, minimal, feminine, and conversion-focused. The layout must include a rounded rectangular container with a soft pastel pink background (#F8DDE7 or similar), subtle shadows, and smooth rounded corners around 16px–20px.
    
    Inside the block:
    
    Add a small outlined clock icon on the left side in pink.
    Beside the icon, display the text:
    “discount ends in”
    in lowercase, bold, modern sans-serif typography.
    On the right side, display a live countdown timer in this format:
    00 : 10 : 36 : 35
    The timer should show:
    Days
    Hours
    Minutes
    Seconds
    Use bold pink typography with evenly spaced digits.
    The timer should update in real-time every second.
    The entire block should feel luxury, soft, and premium like a modern DTC beauty brand.
    
    Functional Requirements:
    
    Fully responsive for mobile and desktop.
    Editable timer expiry date from Shopify theme customizer.
    Auto-reset option for recurring campaigns.
    Smooth hover animation.
    Optimized for conversion and urgency psychology.
    Use clean modern UI with plenty of whitespace.
    
    Design Style:
    
    Minimal luxury beauty ecommerce aesthetic
    Inspired by premium nail/fashion/cosmetic brands
    Soft feminine palette
    Rounded UI elements
    Elegant typography similar to Poppins/Inter/Circular
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-timer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-countdown-timer__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-countdown-timer__container-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical | plus: 4 }}px {{ block.settings.shadow_blur | plus: 8 }}px {{ block.settings.shadow_color }};
  }

  .ai-countdown-timer__left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-countdown-timer__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-countdown-timer__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    text-transform: lowercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
  }

  .ai-countdown-timer__digits-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.digit_spacing }}px;
  }

  .ai-countdown-timer__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .ai-countdown-timer__number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: {{ block.settings.number_weight }};
    color: {{ block.settings.number_color }};
    line-height: 1;
    min-width: {{ block.settings.number_min_width }}px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .ai-countdown-timer__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-countdown-timer__separator-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: {{ block.settings.number_weight }};
    color: {{ block.settings.separator_color }};
    line-height: 1;
    padding-bottom: {{ block.settings.label_size | plus: 4 }}px;
  }

  .ai-countdown-timer__expired-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.expired_text_color }};
    text-align: center;
    padding: 8px 0;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-timer__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-countdown-timer__left-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
    }

    .ai-countdown-timer__digits-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
      gap: {{ block.settings.digit_spacing | times: 0.7 }}px;
    }

    .ai-countdown-timer__number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
      min-width: {{ block.settings.number_min_width | times: 0.8 }}px;
    }

    .ai-countdown-timer__separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
    }

    .ai-countdown-timer__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }

    .ai-countdown-timer__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-countdown-timer__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-timer-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.end_date }}"
  data-end-time="{{ block.settings.end_time }}"
  data-auto-reset="{{ block.settings.auto_reset }}"
  data-reset-days="{{ block.settings.reset_days }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-countdown-timer__container-{{ ai_gen_id }}">
    <div class="ai-countdown-timer__left-{{ ai_gen_id }}">
      <svg
        class="ai-countdown-timer__icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span class="ai-countdown-timer__text-{{ ai_gen_id }}">{{ block.settings.countdown_text }}</span>
    </div>

    <div class="ai-countdown-timer__digits-{{ ai_gen_id }}" data-countdown-display>
      {% if block.settings.show_days %}
        <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
          <span class="ai-countdown-timer__number-{{ ai_gen_id }}" data-days>00</span>
          {% if block.settings.show_labels %}
            <span class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_days }}</span>
          {% endif %}
        </div>
        <span class="ai-countdown-timer__separator-{{ ai_gen_id }}">:</span>
      {% endif %}

      <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
        <span class="ai-countdown-timer__number-{{ ai_gen_id }}" data-hours>00</span>
        {% if block.settings.show_labels %}
          <span class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_hours }}</span>
        {% endif %}
      </div>
      <span class="ai-countdown-timer__separator-{{ ai_gen_id }}">:</span>

      <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
        <span class="ai-countdown-timer__number-{{ ai_gen_id }}" data-minutes>00</span>
        {% if block.settings.show_labels %}
          <span class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_minutes }}</span>
        {% endif %}
      </div>
      <span class="ai-countdown-timer__separator-{{ ai_gen_id }}">:</span>

      <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
        <span class="ai-countdown-timer__number-{{ ai_gen_id }}" data-seconds>00</span>
        {% if block.settings.show_labels %}
          <span class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_seconds }}</span>
        {% endif %}
      </div>
    </div>

    <div class="ai-countdown-timer__expired-{{ ai_gen_id }}" data-expired-message style="display: none;">
      {{ block.settings.expired_message }}
    </div>
  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
        this.autoReset = this.dataset.autoReset === 'true';
        this.resetDays = parseInt(this.dataset.resetDays) || 7;
        this.interval = null;
      }

      connectedCallback() {
        this.countdownDisplay = this.querySelector('[data-countdown-display]');
        this.expiredMessage = this.querySelector('[data-expired-message]');
        this.daysElement = this.querySelector('[data-days]');
        this.hoursElement = this.querySelector('[data-hours]');
        this.minutesElement = this.querySelector('[data-minutes]');
        this.secondsElement = this.querySelector('[data-seconds]');

        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      getEndDateTime() {
        if (!this.endDate) {
          const now = new Date();
          now.setDate(now.getDate() + 1);
          return now;
        }

        const dateTimeString = this.endTime 
          ? `${this.endDate}T${this.endTime}` 
          : `${this.endDate}T23:59:59`;
        
        return new Date(dateTimeString);
      }

      startCountdown() {
        this.updateCountdown();
        this.interval = setInterval(() => this.updateCountdown(), 1000);
      }

      updateCountdown() {
        const now = new Date().getTime();
        let endDateTime = this.getEndDateTime().getTime();

        let distance = endDateTime - now;

        if (distance < 0) {
          if (this.autoReset) {
            const newEndDate = new Date();
            newEndDate.setDate(newEndDate.getDate() + this.resetDays);
            this.endDate = newEndDate.toISOString().split('T')[0];
            endDateTime = this.getEndDateTime().getTime();
            distance = endDateTime - now;
          } else {
            this.showExpired();
            return;
          }
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        if (this.daysElement) {
          this.daysElement.textContent = this.padZero(days);
        }
        this.hoursElement.textContent = this.padZero(hours);
        this.minutesElement.textContent = this.padZero(minutes);
        this.secondsElement.textContent = this.padZero(seconds);
      }

      showExpired() {
        if (this.interval) {
          clearInterval(this.interval);
        }
        if (this.countdownDisplay) {
          this.countdownDisplay.style.display = 'none';
        }
        if (this.expiredMessage) {
          this.expiredMessage.style.display = 'block';
        }
      }

      padZero(num) {
        return num.toString().padStart(2, '0');
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

