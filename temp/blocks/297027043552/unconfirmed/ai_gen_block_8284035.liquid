{% doc %}
  @prompt
    Product Feature Highlights Block
    
    Create a premium Shopify product feature highlights section for a beauty/nail ecommerce product page. The section should showcase key product benefits in a clean luxury layout similar to modern cosmetic brands.
    
    The block must contain 3 feature items arranged vertically on mobile and horizontally or grid-style on desktop.
    
    Each feature item should include:
    
    A small elegant icon in soft pink
    Bold feature title text
    Clean spacing and minimal aesthetic
    
    Features to include exactly:
    
    lasts 2–3 weeks
    Use a sparkle or durability icon
    Communicate long-lasting premium quality
    apply in < 10Min without UV
    Use an hourglass or lightning icon
    Highlight fast and easy application
    Emphasize “without UV”
    strong + non-toxic glue
    Use a glue tube or safety icon
    Emphasize durability and safe ingredients
    
    Design Requirements:
    
    Soft feminine luxury beauty aesthetic
    Minimal modern typography
    Elegant spacing with breathable layout
    Icons in pastel pink
    White or very light neutral background
    Rounded containers if needed
    Responsive mobile-first design
    High-end DTC ecommerce styling
    
    Typography:
    
    Use bold modern sans-serif fonts
    Strong readability on mobile
    Slightly playful but premium tone
    
    Technical Requirements:
    
    Built for Shopify product page
    Use Shopify Liquid + HTML + CSS
    Optimized for mobile conversion
    Lightweight and fast loading
    Easy to customize text/icons later
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-highlights-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-feature-highlights__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.mobile_spacing }}px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-highlights__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: {{ block.settings.desktop_spacing }}px;
    }
  }

  .ai-feature-highlights__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.2s ease;
  }

  .ai-feature-highlights__icon-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-feature-highlights__icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    color: {{ block.settings.icon_color }};
  }

  .ai-feature-highlights__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-highlights__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-feature-highlights-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-highlights__container-{{ ai_gen_id }}">
    <div class="ai-feature-highlights__item-{{ ai_gen_id }}">
      <div class="ai-feature-highlights__icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-feature-highlights__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </div>
      <h3 class="ai-feature-highlights__title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
    </div>

    <div class="ai-feature-highlights__item-{{ ai_gen_id }}">
      <div class="ai-feature-highlights__icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-feature-highlights__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"/>
        </svg>
      </div>
      <h3 class="ai-feature-highlights__title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
    </div>

    <div class="ai-feature-highlights__item-{{ ai_gen_id }}">
      <div class="ai-feature-highlights__icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-feature-highlights__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          <circle cx="12" cy="12" r="10"/>
        </svg>
      </div>
      <h3 class="ai-feature-highlights__title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature highlights",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Feature 1 title",
      "default": "lasts 2–3 weeks"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Feature 2 title",
      "default": "apply in < 10Min without UV"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Feature 3 title",
      "default": "strong + non-toxic glue"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_spacing",
      "label": "Desktop spacing",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "label": "Mobile spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon spacing",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFB6C1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "item_background_color",
