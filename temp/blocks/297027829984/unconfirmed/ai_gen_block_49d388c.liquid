{% doc %}
  @prompt
    Product Feature Highlights Block
    
    Create a premium Shopify product feature highlights section for a beauty/nail ecommerce product page. The section should showcase key product benefits in a clean luxury layout similar to modern cosmetic brands.
    
    The block must contain 3 feature items arranged vertically on mobile and horizontally or grid-style on desktop.
    
    Each feature item should include:
    
    A small elegant icon in soft pink
    Bold feature title text
    Clean spacing and minimal aesthetic
    
    Features to include exactly:
    
    lasts 2–3 weeks
    Use a sparkle or durability icon
    Communicate long-lasting premium quality
    apply in < 10Min without UV
    Use an hourglass or lightning icon
    Highlight fast and easy application
    Emphasize “without UV”
    strong + non-toxic glue
    Use a glue tube or safety icon
    Emphasize durability and safe ingredients
    
    Design Requirements:
    
    Soft feminine luxury beauty aesthetic
    Minimal modern typography
    Elegant spacing with breathable layout
    Icons in pastel pink
    White or very light neutral background
    Rounded containers if needed
    Responsive mobile-first design
    High-end DTC ecommerce styling
    
    Typography:
    
    Use bold modern sans-serif fonts
    Strong readability on mobile
    Slightly playful but premium tone
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-highlights-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-feature-highlights__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-feature-highlights__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.mobile_gap }}px;
  }

  .ai-feature-highlights__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.3s ease;
  }

  .ai-feature-highlights__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-feature-highlights__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
  }

  .ai-feature-highlights__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.3px;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-highlights__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
      gap: {{ block.settings.desktop_gap }}px;
    }

    .ai-feature-highlights__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 1.1 }}px;
    }
  }
{% endstyle %}

<product-feature-highlights-{{ ai_gen_id }}
  class="ai-feature-highlights-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-feature-highlights__container-{{ ai_gen_id }}">
    <div class="ai-feature-highlights__grid-{{ ai_gen_id }}">
      
      <div class="ai-feature-highlights__item-{{ ai_gen_id }}">
        <div class="ai-feature-highlights__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <h3 class="ai-feature-highlights__title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
      </div>

      <div class="ai-feature-highlights__item-{{ ai_gen_id }}">
        <div class="ai-feature-highlights__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
        </div>
        <h3 class="ai-feature-highlights__title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
      </div>

      <div class="ai-feature-highlights__item-{{ ai_gen_id }}">
        <div class="ai-feature-highlights__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <h3 class="ai-feature-highlights__title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
      </div>

    </div>
  </div>
</product-feature-highlights-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductFeatureHighlights{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-feature-highlights-{{ ai_gen_id }}', ProductFeatureHighlights{{ ai_gen_id }});
  })();
</script>

