{% doc %}
  @prompt
    Create a premium compact “Product Add-ons” block for a Shopify product page that allows the merchant to select and display 4–6 recommended products using Shopify product picker functionality inside the theme customizer.
    
    The section should be designed for modern high-converting ecommerce brands and appear below or near the Add to Cart button without taking too much vertical space. The layout must feel sleek, minimal, premium, and mobile-optimized.
    
    Core Functionality:
    
    Include Shopify product picker support in theme settings
    Allow selecting 4–6 products dynamically
    Display selected products automatically inside the block
    Each product card should be compact and horizontally scrollable on mobile
    Clicking a product should allow quick add-to-cart or product navigation
    
    Each Product Item Must Include:
    
    Small rounded product image thumbnail
    Product title (1 line max with ellipsis)
    Price
    Tiny “Add” or “+” button
    Optional checkbox selection style
    
    Design Style:
    
    Ultra compact premium UI
    Luxury DTC beauty/fashion ecommerce inspired
    Minimal spacing with clean alignment
    Rounded corners everywhere
    Soft shadows and subtle borders
    Smooth hover animations
    Elegant typography similar to Inter/Poppins
    Mobile-first responsive design
    
    Layout Requirements:
    
    Horizontal slider/carousel style on mobile
    Grid or horizontal layout on desktop
    Compact card height
    Smooth scrolling/snapping effect
    Maintain clean visual hierarchy
    
    
    it must work properly on adding any addon it must be added into the cart , make it more compact reduce the size of the overall product card , evrything must be in single raw if it's not fitting in single row make them scrollable  horizontally 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-addons-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 16px 0;
  }

  .ai-product-addons-container-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-product-addons-header-{{ ai_gen_id }} {
    margin-bottom: 12px;
  }

  .ai-product-addons-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 2px 0;
    letter-spacing: -0.01em;
  }

  .ai-product-addons-subtitle-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .ai-product-addons-grid-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    gap: {{ block.settings.card_spacing }}px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
    padding-bottom: 4px;
  }

  .ai-product-addons-grid-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 6px;
  }

  .ai-product-addons-grid-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-product-addons-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: {{ block.settings.scrollbar_color }};
    border-radius: 3px;
  }

  .ai-product-addons-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
    background: {{ block.settings.scrollbar_hover_color }};
  }

  .ai-product-addon-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: all 0.2s ease;
    position: relative;
    cursor: pointer;
    min-width: 110px;
    max-width: 110px;
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  .ai-product-addon-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px {{ block.settings.shadow_color }};
    border-color: {{ block.settings.card_hover_border }};
  }

  .ai-product-addon-card-{{ ai_gen_id }}.selected {
    border-color: {{ block.settings.selected_border_color }};
    background: {{ block.settings.selected_background }};
  }

  .ai-product-addon-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .ai-product-addon-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-addon-checkbox-{{ ai_gen_id }} {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: {{ block.settings.checkbox_background }};
    border: 1.5px solid {{ block.settings.checkbox_border }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    opacity: 0;
  }

  .ai-product-addon-card-{{ ai_gen_id }}:hover .ai-product-addon-checkbox-{{ ai_gen_id }},
  .ai-product-addon-card-{{ ai_gen_id }}.selected .ai-product-addon-checkbox-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-product-addon-card-{{ ai_gen_id }}.selected .ai-product-addon-checkbox-{{ ai_gen_id }} {
    background: {{ block.settings.checkbox_active_background }};
    border-color: {{ block.settings.checkbox_active_border }};
  }

  .ai-product-addon-checkmark-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    stroke: {{ block.settings.checkbox_checkmark_color }};
    stroke-width: 2;
    fill: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .ai-product-addon-card-{{ ai_gen_id }}.selected .ai-product-addon-checkmark-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-product-addon-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-product-addon-title-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  .ai-product-addon-price-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 600;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-product-addon-add-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: 6px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-addon-add-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text }};
    border-color: {{ block.settings.button_hover_border }};
  }

  .ai-product-addon-add-btn-{{ ai_gen_id }}.added {
    background: {{ block.settings.button_added_background }};
    color: {{ block.settings.button_added_text }};
    border-color: {{ block.settings.button_added_border }};
  }

  .ai-product-addon-loading-{{ ai_gen_id }} {
    pointer-events: none;
    opacity: 0.6;
  }

  .ai-product-addon-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 24px 16px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    font-size: 13px;
  }
{% endstyle %}

<product-addons-{{ ai_gen_id }} class="ai-product-addons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    assign has_products = false
    for i in (1..6)
      assign product_key = 'addon_product_' | append: i
      if block.settings[product_key] != blank
        assign has_products = true
        break
      endif
    endfor
  %}

  {% if has_products %}
    <div class="ai-product-addons-container-{{ ai_gen_id }}">
      <div class="ai-product-addons-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h3 class="ai-product-addons-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-product-addons-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>

      <div class="ai-product-addons-grid-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign product_key = 'addon_product_' | append: i
            assign addon_product = block.settings[product_key]
          %}

          {% if addon_product != blank %}
            <div 
              class="ai-product-addon-card-{{ ai_gen_id }}" 
              data-product-id="{{ addon_product.id }}"
              data-variant-id="{{ addon_product.selected_or_first_available_variant.id }}"
              data-product-title="{{ addon_product.title | escape }}"
            >
              <div class="ai-product-addon-image-wrapper-{{ ai_gen_id }}">
                {% if addon_product.featured_image %}
                  <img
                    src="{{ addon_product.featured_image | image_url: width: 200 }}"
                    alt="{{ addon_product.featured_image.alt | escape }}"
                    class="ai-product-addon-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-product-addon-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-product-addon-checkbox-{{ ai_gen_id }}">
                  <svg class="ai-product-addon-checkmark-{{ ai_gen_id }}" viewBox="0 0 12 10">
                    <polyline points="1.5 6 4.5 9 10.5 1"></polyline>
                  </svg>
                </div>
              </div>

              <div class="ai-product-addon-info-{{ ai_gen_id }}">
                <h4 class="ai-product-addon-title-{{ ai_gen_id }}">{{ addon_product.title }}</h4>
                <p class="ai-product-addon-price-{{ ai_gen_id }}">
                  {{ addon_product.selected_or_first_available_variant.price | money }}
                </p>
              </div>

              <button 
                type="button" 
                class="ai-product-addon-add-btn-{{ ai_gen_id }}"
                data-add-button
              >
                {{ block.settings.button_text }}
              </button>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="ai-product-addons-container-{{ ai_gen_id }}">
      <div class="ai-product-addon-empty-{{ ai_gen_id }}">
        Select products to display as add-ons
      </div>
    </div>
  {% endif %}
</product-addons-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductAddons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.selectedAddons = new Set();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-product-addon-card-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.cards.forEach(card => {
          const addButton = card.querySelector('[data-add-button]');
          
          card.addEventListener('click', (e) => {
            if (e.target === addButton) return;
            this.toggleSelection(card);
          });

          addButton.addEventListener('click', (e) => {
            e.stopPropagation();
            this.addToCart(card, addButton);
          });
        });
      }

      toggleSelection(card) {
        const variantId = card.dataset.variantId;
        
        if (this.selectedAddons.has(variantId)) {
          this.selectedAddons.delete(variantId);
          card.classList.remove('selected');
        } else {
          this.selectedAddons.add(variantId);
          card.classList.add('selected');
        }
      }

      async addToCart(card, button) {
        const variantId = card.dataset.variantId;
        const productTitle = card.dataset.productTitle;
        
        if (!variantId) return;

        const originalText = button.textContent;
        button.classList.add('ai-product-addon-loading-{{ ai_gen_id }}');
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          button.textContent = 'Added!';
          button.classList.add('added');
          card.classList.add('selected');
          this.selectedAddons.add(variantId);

          const cartUpdateEvent = new CustomEvent('cart:updated', {
            bubbles: true,
            detail: { source: 'product-addons' }
          });
          document.dispatchEvent(cartUpdateEvent);

          setTimeout(() => {
            button.textContent = originalText;
            button.classList.remove('added');
          }, 2000);

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error';
          
          setTimeout(() => {
            button.textContent = originalText;
          }, 2000);
        } finally {
          button.classList.remove('ai-product-addon-loading-{{ ai_gen_id }}');
        }
      }
    }

    customElements.define('product-addons-{{ ai_gen_id }}', ProductAddons{{ ai_gen_id }});
  })();
</script>

