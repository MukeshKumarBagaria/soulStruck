{% doc %}
  @prompt
    Create a premium Shopify section inspired by Instagram Reels / TikTok product story sliders. The section should display up to 10 vertical autoplay product videos in horizontally scrollable cards. Each card must contain a muted looping vertical video with elegant rounded corners and a luxury modern aesthetic. Clicking anywhere on a card should redirect users to its assigned product page.
    
    The section should include:
    
    Horizontally scrollable layout
    Vertical 9:16 videos
    Autoplay enabled
    Muted videos only
    Infinite loop playback
    No controls visible
    Mobile-first responsive design
    Smooth scrolling experience
    Hidden scrollbar
    Premium beauty/fashion/ecommerce feel
    Optional overlay text at the bottom of each card
    Fully clickable card
    Shopify theme editor compatible
    Support for up to 10 video blocks
    Separate product URL/link for each video card
    Elegant hover effect on desktop
    Object-fit cover videos
    Optimized loading performance
    Rounded corners with subtle shadow
    Clean spacing similar to luxury skincare/nail/fashion brands
    
    Each block should contain:
    
    Video upload picker
    Product link picker
    Optional overlay text
    
    The section settings should include:
    
    Heading text
    Card width control
    Border radius control
    Optional autoplay toggle
    Optional overlay enable/disable
    
    Design inspiration:
    Luxury beauty ecommerce brands, Instagram story reels, TikTok product showcase sections, modern Gen-Z fashion websites.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-reel-card-{{ ai_gen_id }} {
    display: inline-block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: {{ block.settings.card_width }}px;
    aspect-ratio: 9 / 16;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    background: linear-gradient(135deg, #f8f8f8 0%, #e8e8e8 100%);
    vertical-align: top;
  }

  .ai-product-reel-card-{{ ai_gen_id }}:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
  }

  .ai-product-reel-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-reel-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 20px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0) 100%);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    pointer-events: none;
    letter-spacing: 0.3px;
  }

  .ai-product-reel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #fafafa 0%, #e5e5e5 100%);
    color: #999999;
    font-size: 14px;
    text-align: center;
    padding: 24px;
    gap: 12px;
  }

  .ai-product-reel-placeholder-{{ ai_gen_id }} svg {
    width: 48px;
    height: 48px;
    opacity: 0.4;
  }

  @media screen and (max-width: 749px) {
    .ai-product-reel-card-{{ ai_gen_id }} {
      max-width: calc({{ block.settings.card_width }}px * 0.7);
    }

    .ai-product-reel-card-{{ ai_gen_id }}:hover {
      transform: none;
    }

    .ai-product-reel-overlay-{{ ai_gen_id }} {
      padding: 16px;
      font-size: 13px;
    }
  }
{% endstyle %}

<product-reel-card-{{ ai_gen_id }} class="ai-product-reel-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.video != blank %}
    <video
      class="ai-product-reel-video-{{ ai_gen_id }}"
      {% if block.settings.autoplay_enabled %}autoplay{% endif %}
      loop
      muted
      playsinline
      preload="metadata"
      data-video-url="{{ block.settings.product_url }}"
    >
      <source src="{{ block.settings.video }}" type="video/mp4">
    </video>

    {% if block.settings.show_overlay and block.settings.overlay_text != blank %}
      <div class="ai-product-reel-overlay-{{ ai_gen_id }}">
        {{ block.settings.overlay_text }}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-product-reel-placeholder-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="23 7 16 12 23 17 23 7"></polygon>
        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
      </svg>
      <span>Add vertical video<br>(9:16 ratio recommended)</span>
    </div>
  {% endif %}
</product-reel-card-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductReelCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.video = null;
        this.observer = null;
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-product-reel-video-{{ ai_gen_id }}');
        this.setupClickHandler();
        if (this.video) {
          this.setupIntersectionObserver();
        }
      }

      setupClickHandler() {
        this.addEventListener('click', () => {
          if (this.video) {
            const productUrl = this.video.getAttribute('data-video-url');
            if (productUrl) {
              window.location.href = productUrl;
            }
          }
        });
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.5
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.video.play().catch(() => {});
            } else {
              this.video.pause();
            }
          });
        }, options);

        this.observer.observe(this.video);
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('product-reel-card-{{ ai_gen_id }}', ProductReelCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product story reel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "url",
      "id": "product_url",
      "label": "Product link"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay text",
      "default": true
    },
    {
      "type": "text",
      "id": "overlay_text",
      "label": "Overlay text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Maximum card width",
      "min": 200,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Product story reel"
    }
  ]
}
{% endschema %}