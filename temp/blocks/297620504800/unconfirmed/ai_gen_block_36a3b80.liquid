{% doc %}
  @prompt
    create an block to create section title  , put the default value , you might also like
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-section-title-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-section-title__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.font_size }}px;
    {% if block.settings.text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-section-title__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-section-title-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading_tag == 'h1' %}
    <h1 class="ai-section-title__heading-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
  {% elsif block.settings.heading_tag == 'h2' %}
    <h2 class="ai-section-title__heading-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% elsif block.settings.heading_tag == 'h3' %}
    <h3 class="ai-section-title__heading-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
  {% elsif block.settings.heading_tag == 'h4' %}
    <h4 class="ai-section-title__heading-{{ ai_gen_id }}">{{ block.settings.title }}</h4>
  {% elsif block.settings.heading_tag == 'h5' %}
    <h5 class="ai-section-title__heading-{{ ai_gen_id }}">{{ block.settings.title }}</h5>
  {% else %}
    <h6 class="ai-section-title__heading-{{ ai_gen_id }}">{{ block.settings.title }}</h6>
  {% endif %}
</div>

{% schema %}
{
  "name": "Section title",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You might also like"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile font size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Section title"
    }
  ],
  "tag": null
}
{% endschema %}
